# ── SIGNALIS-OS // Configuração de ambiente ──────────────────────────────────
# Copie este arquivo para .env e preencha os valores.

# Credenciais de acesso ao sistema
SIGNALIS_USERNAME=Nyx
SIGNALIS_PASSWORD=sua_senha_aqui
SIGNALIS_GOD_USERS=Nyx

# Provider LLM (ollama | openrouter | groq | openai)
LLM_PROVIDER=ollama
LLM_API_KEY=

# Endereço do Ollama (se LLM_PROVIDER=ollama)
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# Porta do servidor local
PORT=8000

# Ngrok (para acesso remoto via túnel público)
NGROK_AUTHTOKEN=

# ── Spotify Web API ───────────────────────────────────────────────────────────
# Para usar spotify.search, spotify.play e spotify.playlist:
#   1. Acesse https://developer.spotify.com/dashboard
#   2. Crie um app (tipo: "Web API")
#   3. Copie o Client ID e o Client Secret abaixo
#
# Obs: as funções usam Client Credentials (sem login do usuário).
# Para controle do player em tempo real (pause/resume) seria necessário OAuth.
SPOTIFY_CLIENT_ID=seu_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_client_secret_aqui
