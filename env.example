# SIGNALIS-OS — Configuração de ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env no Git (já está no .gitignore)

# ── Provider LLM ──────────────────────────────────────────────
# Opções: ollama | openrouter | groq | openai
LLM_PROVIDER=ollama

# ── Chave de API (só necessária para providers cloud) ─────────
# OpenRouter: https://openrouter.ai/keys
# Groq:       https://console.groq.com/keys
# OpenAI:     https://platform.openai.com/api-keys
LLM_API_KEY=

# ── Ollama (só se LLM_PROVIDER=ollama) ───────────────────────
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# ── Porta do servidor ─────────────────────────────────────────
PORT=8000
